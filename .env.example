# Copy this file to .env.local. Do not commit .env.local.

# ─── Clerk (auth + billing) ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for the Clerk webhook (Dashboard → Webhooks → your endpoint).
CLERK_WEBHOOK_SECRET=
# Set to "true" after enabling Clerk Billing + creating Plans in the Dashboard.
NEXT_PUBLIC_CLERK_BILLING_ENABLED=false

# ─── Neon (Postgres) + Drizzle ────────────────────────────────────────────────
# Populated automatically by the Vercel Neon integration (`vercel env pull`).
DATABASE_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host.neon.tech/neondb?sslmode=require

# ─── Site URL (Clerk redirects) ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Vercel Blob (file storage) ───────────────────────────────────────────────
# Injected by the Vercel Blob integration (`vercel env pull`).
BLOB_READ_WRITE_TOKEN=
# Optional — only needed for legacy/relative object keys.
NEXT_PUBLIC_BLOB_BASE_URL=

# ─── Ably (realtime) ──────────────────────────────────────────────────────────
ABLY_SERVER_KEY=
NEXT_PUBLIC_ABLY_CLIENT_KEY=

# ─── Cron (Vercel) ────────────────────────────────────────────────────────────
CRON_SECRET=

# ─── AI (real LLM features) ─────────────────────────────────────────────────────
# Vercel AI Gateway: https://vercel.com/docs/ai-gateway
# Enables LLM-personalised AI actions and "Draft with AI" in the inbox.
# Without a key the app falls back to deterministic heuristics (no errors).
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Model id for the gateway (or bare id when using OPENAI_API_KEY directly).
AI_MODEL=openai/gpt-4o-mini
# Optional: use OpenAI directly instead of the gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ─── Email delivery (Resend) ────────────────────────────────────────────────────
# https://resend.com — EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=

# ─── SMS delivery (Twilio) ──────────────────────────────────────────────────────
# https://twilio.com — TWILIO_FROM_NUMBER must be E.164 (e.g. +15551234567).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Billing ──────────────────────────────────────────────────────────────────
# Handled by Clerk Billing (Stripe under the hood) — no extra keys required.
# New accounts get a 15-day free trial; Plans are managed in the Clerk Dashboard.
